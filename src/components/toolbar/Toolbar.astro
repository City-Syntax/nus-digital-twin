---
import ScreenshotButton from './ScreenshotButton.astro';
import HomeButton from './HomeButton.astro';
import MapPickerButton from './MapPickerButton';
import { getImagePreviews } from '../../lib/imagePreviews';

const imagePreviews = await getImagePreviews(
  ['/src/assets/mapbox-street.png', '/src/assets/mapbox-dark.png', '/src/assets/mapbox-satellite.png'],
  192,
);
---

<div class="toolbar">
  <div class="toolbar__section">
    <ScreenshotButton />
  </div>
  <div class="toolbar__section">
    <MapPickerButton client:only="react" imagePreviews={imagePreviews} />
    <HomeButton />
  </div>
</div>
