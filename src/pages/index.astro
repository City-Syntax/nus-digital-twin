---
import Menu from '../components/menu/Menu';
import CesiumScene from '../components/cesium/CesiumScene.astro';
import Toolbar from '../components/toolbar/Toolbar.astro';
import BottomBar from '../components/bottom-bar/BottomBar.astro';
import NotificationsBox from '../components/notifications/NotificationsBox';
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout>
  <Menu client:only="react" />
  <CesiumScene />
  <Toolbar />
  <NotificationsBox client:only="react" />
  <BottomBar />
</AppLayout>
<script>
  import { autoUpdate, computePosition, flip, offset, shift, type Placement } from '@floating-ui/dom';

  const registeredTooltips = new WeakSet<Element>();

  const registerTooltip = (selector: string, content: string, placement: Placement = 'top') => {
    document.querySelectorAll<HTMLElement>(selector).forEach((reference) => {
      if (registeredTooltips.has(reference)) return;
      registeredTooltips.add(reference);

      let tooltip: HTMLDivElement | undefined;
      let cleanup: (() => void) | undefined;
      let hideTimeout: number | undefined;

      const update = () => {
        if (!tooltip) return;

        computePosition(reference, tooltip, {
          placement,
          strategy: 'fixed',
          middleware: [offset(8), flip(), shift({ padding: 8 })],
        }).then(({ x, y }) => {
          if (!tooltip) return;
          Object.assign(tooltip.style, {
            left: `${x}px`,
            top: `${y}px`,
          });
        });
      };

      const show = () => {
        window.clearTimeout(hideTimeout);
        if (tooltip) {
          tooltip.dataset.state = 'open';
          return;
        }

        tooltip = document.createElement('div');
        tooltip.className = 'tooltip';
        tooltip.dataset.state = 'open';
        tooltip.textContent = content;
        Object.assign(tooltip.style, {
          left: '0',
          position: 'fixed',
          top: '0',
        });
        document.body.appendChild(tooltip);
        cleanup = autoUpdate(reference, tooltip, update);
      };

      const hide = () => {
        if (!tooltip) return;

        cleanup?.();
        cleanup = undefined;
        tooltip.dataset.state = 'closed';
        hideTimeout = window.setTimeout(() => {
          tooltip?.remove();
          tooltip = undefined;
        }, 150);
      };

      reference.addEventListener('pointerenter', show);
      reference.addEventListener('pointerleave', hide);
      reference.addEventListener('focus', show);
      reference.addEventListener('blur', hide);
    });
  };

  const registerAllTooltips = () => {
    registerTooltip('#home-btn', 'Reset view');
    registerTooltip('#screenshot-btn', 'Screenshot current view');
    registerTooltip('#map-picker-btn', 'Map picker');
  };

  registerAllTooltips();
  new MutationObserver(registerAllTooltips).observe(document.body, { childList: true, subtree: true });
</script>
