  ,                        !- Dedicated Outdoor Air Low Setpoint Temperature for Design {C}
  ;                        !- Dedicated Outdoor Air High Setpoint Temperature for Design {C}


!------------------------ Thermostat RVRCBlockG_0------------------------

Schedule:Constant,
  RVRCBlockG_0Heating_SP_Sch, !- Name
  Temperature, !- Schedule Type Limits Name
  0; !- HeatingSetpoint

Schedule:Constant,
  RVRCBlockG_0Cooling_SP_Sch, !- Name
  Temperature, !- Schedule Type Limits Name
  0; !- CoolingSetpoint


ZoneControl:Thermostat,
  RVRCBlockG_0 Thermostat, !- Name
  RVRCBlockG_0,            !- Zone or ZoneList Name
  RVRCBlockG_0_ZoneControlTypeSched, !- Control Type Schedule Name
  ThermostatSetpoint:DualSetpoint,  !- Control 1 Object Type
  Dual Setpoint - Zone RVRCBlockG_0;  !- Control 1 Name

Schedule:Constant,
  RVRCBlockG_0_ZoneControlTypeSched, !- Name
  Any Number, !- Schedule Type Limits Name
  4; !- Hourly Value

ThermostatSetpoint:DualSetpoint,
  Dual Setpoint - Zone RVRCBlockG_0,  !- Name
  ApartmentMidRise HTGSETP_APT_SCH,  !- Heating Setpoint Temperature Schedule Name
  ApartmentMidRise CLGSETP_APT_SCH;  !- Cooling Setpoint Temperature Schedule Name


!------------------------ Humidistat RVRCBlockG_0------------------------

ZoneControl:Humidistat,
    RVRCBlockG_0Humidistat,                  !-Name
    RVRCBlockG_0,                   !-Zone Name
    RVRCBlockG_0HumidMin,                !-Humidifying Relative Humidity Setpoint Schedule Name
    RVRCBlockG_0HumidMax; !-Dehumidifying Relative Humidity Setpoint Schedule Name

Schedule:Constant,
    RVRCBlockG_0HumidMin,                !- Name
    Any Number,              !- Schedule Type Limits Name
    20; !- MinHumidity

Schedule:Constant,
    RVRCBlockG_0HumidMax,                !- Name
    Any Number,              !- Schedule Type Limits Name
    80; !- MaxHumidity


!------------------------ OutdoorAir RVRCBlockG_0------------------------

DesignSpecification:OutdoorAir,
  RVRCBlockG_0MinFreshAir,                  !- Name
  Sum,                     !- Outdoor Air Method
  0.001, !- @RVRCBlockG_0-MinFreshAirPerson@ [m3/s-person]
  0.01, !- @RVRCBlockG_0-MinFreshAirArea@ [m3/s-m2]
    ,                        !- Outdoor Air Flow per Zone [m3/s]
    ,                        !- Outdoor Air Flow Air Changes per Hour [1/hr]
    AllOn; !- MechVentSchedule



