  NUSS_0_ZoneControlTypeSched, !- Control Type Schedule Name
  ThermostatSetpoint:DualSetpoint,  !- Control 1 Object Type
  Dual Setpoint - Zone NUSS_0;  !- Control 1 Name

Schedule:Constant,
  NUSS_0_ZoneControlTypeSched, !- Name
  Any Number, !- Schedule Type Limits Name
  4; !- Hourly Value

ThermostatSetpoint:DualSetpoint,
  Dual Setpoint - Zone NUSS_0,  !- Name
  NUSS_0Heating_SP_Sch,  !- Heating Setpoint Temperature Schedule Name
  NUSS_0Cooling_SP_Sch;  !- Cooling Setpoint Temperature Schedule Name


!------------------------ Humidistat NUSS_0------------------------

ZoneControl:Humidistat,
    NUSS_0Humidistat,                  !-Name
    NUSS_0,                   !-Zone Name
    NUSS_0HumidMin,                !-Humidifying Relative Humidity Setpoint Schedule Name
    NUSS_0HumidMax; !-Dehumidifying Relative Humidity Setpoint Schedule Name

Schedule:Constant,
    NUSS_0HumidMin,                !- Name
    Any Number,              !- Schedule Type Limits Name
    20; !- MinHumidity

Schedule:Constant,
    NUSS_0HumidMax,                !- Name
    Any Number,              !- Schedule Type Limits Name
    80; !- MaxHumidity


!------------------------ OutdoorAir NUSS_0------------------------

DesignSpecification:OutdoorAir,
  NUSS_0MinFreshAir,                  !- Name
  Sum,                     !- Outdoor Air Method
  0.00235975, !- @NUSS_0-MinFreshAirPerson@ [m3/s-person]
  0.0003048017825043325, !- @NUSS_0-MinFreshAirArea@ [m3/s-m2]
    ,                        !- Outdoor Air Flow per Zone [m3/s]
    ,                        !- Outdoor Air Flow Air Changes per Hour [1/hr]
    AllOn; !- MechVentSchedule



