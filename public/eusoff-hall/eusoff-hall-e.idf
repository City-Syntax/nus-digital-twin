!------------------------ Thermostat HAll_0------------------------

Schedule:Constant,
  HAll_0Heating_SP_Sch, !- Name
  Temperature, !- Schedule Type Limits Name
  20; !- HeatingSetpoint

Schedule:Constant,
  HAll_0Cooling_SP_Sch, !- Name
  Temperature, !- Schedule Type Limits Name
  26; !- CoolingSetpoint


ZoneControl:Thermostat,
  HAll_0 Thermostat, !- Name
  HAll_0,            !- Zone or ZoneList Name
  HAll_0_ZoneControlTypeSched, !- Control Type Schedule Name
  ThermostatSetpoint:DualSetpoint,  !- Control 1 Object Type
  Dual Setpoint - Zone HAll_0;  !- Control 1 Name

Schedule:Constant,
  HAll_0_ZoneControlTypeSched, !- Name
  Any Number, !- Schedule Type Limits Name
  4; !- Hourly Value

ThermostatSetpoint:DualSetpoint,
  Dual Setpoint - Zone HAll_0,  !- Name
  HAll_0Heating_SP_Sch,  !- Heating Setpoint Temperature Schedule Name
  HAll_0Cooling_SP_Sch;  !- Cooling Setpoint Temperature Schedule Name


!------------------------ Humidistat HAll_0------------------------

ZoneControl:Humidistat,
    HAll_0Humidistat,                  !-Name
    HAll_0,                   !-Zone Name
    HAll_0HumidMin,                !-Humidifying Relative Humidity Setpoint Schedule Name
    HAll_0HumidMax; !-Dehumidifying Relative Humidity Setpoint Schedule Name

Schedule:Constant,
    HAll_0HumidMin,                !- Name
    Any Number,              !- Schedule Type Limits Name
    20; !- MinHumidity

Schedule:Constant,
    HAll_0HumidMax,                !- Name
    Any Number,              !- Schedule Type Limits Name
    80; !- MaxHumidity


!------------------------ OutdoorAir HAll_0------------------------

DesignSpecification:OutdoorAir,
  HAll_0MinFreshAir,                  !- Name
  Sum,                     !- Outdoor Air Method
  0.001, !- @HAll_0-MinFreshAirPerson@ [m3/s-person]
  0.01, !- @HAll_0-MinFreshAirArea@ [m3/s-m2]
    ,                        !- Outdoor Air Flow per Zone [m3/s]
    ,                        !- Outdoor Air Flow Air Changes per Hour [1/hr]
    AllOn; !- MechVentSchedule



