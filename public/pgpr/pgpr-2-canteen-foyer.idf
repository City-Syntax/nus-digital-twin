!------------------------ Thermostat PGPR_0------------------------

Schedule:Constant,
  PGPR_0Heating_SP_Sch, !- Name
  Temperature, !- Schedule Type Limits Name
  20; !- HeatingSetpoint

Schedule:Constant,
  PGPR_0Cooling_SP_Sch, !- Name
  Temperature, !- Schedule Type Limits Name
  26; !- CoolingSetpoint


ZoneControl:Thermostat,
  PGPR_0 Thermostat, !- Name
  PGPR_0,            !- Zone or ZoneList Name
  PGPR_0_ZoneControlTypeSched, !- Control Type Schedule Name
  ThermostatSetpoint:DualSetpoint,  !- Control 1 Object Type
  Dual Setpoint - Zone PGPR_0;  !- Control 1 Name

Schedule:Constant,
  PGPR_0_ZoneControlTypeSched, !- Name
  Any Number, !- Schedule Type Limits Name
  4; !- Hourly Value

ThermostatSetpoint:DualSetpoint,
  Dual Setpoint - Zone PGPR_0,  !- Name
  PGPR_0Heating_SP_Sch,  !- Heating Setpoint Temperature Schedule Name
  PGPR_0Cooling_SP_Sch;  !- Cooling Setpoint Temperature Schedule Name


!------------------------ Humidistat PGPR_0------------------------

ZoneControl:Humidistat,
    PGPR_0Humidistat,                  !-Name
    PGPR_0,                   !-Zone Name
    PGPR_0HumidMin,                !-Humidifying Relative Humidity Setpoint Schedule Name
    PGPR_0HumidMax; !-Dehumidifying Relative Humidity Setpoint Schedule Name

Schedule:Constant,
    PGPR_0HumidMin,                !- Name
    Any Number,              !- Schedule Type Limits Name
    20; !- MinHumidity

Schedule:Constant,
    PGPR_0HumidMax,                !- Name
    Any Number,              !- Schedule Type Limits Name
    80; !- MaxHumidity


!------------------------ OutdoorAir PGPR_0------------------------

DesignSpecification:OutdoorAir,
  PGPR_0MinFreshAir,                  !- Name
  Sum,                     !- Outdoor Air Method
  0, !- @PGPR_0-MinFreshAirPerson@ [m3/s-person]
  0, !- @PGPR_0-MinFreshAirArea@ [m3/s-m2]
    ,                        !- Outdoor Air Flow per Zone [m3/s]
    ,                        !- Outdoor Air Flow Air Changes per Hour [1/hr]
    AllOn; !- MechVentSchedule



