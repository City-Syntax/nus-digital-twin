!------------------------Ideal Loads System AS4_0------------------------

ZoneHVAC:EquipmentConnections,
  AS4_0,            !- Zone Name
  AS4_0 Equipment,  !- Zone Conditioning Equipment List Name
  AS4_0 Inlets,     !- Zone Air Inlet Node or NodeList Name
  ,                         !- Zone Air Exhaust Node or NodeList Name
  Node AS4_0 Zone,  !- Zone Air Node Name
  Node AS4_0 Out;   !- Zone Return Air Node Name

ZoneHVAC:EquipmentList,
  AS4_0 Equipment,       !- Name
  UniformLoad,                   !- Load Distribution Scheme
  ZoneHVAC:IdealLoadsAirSystem,  !- Zone Equipment 1 Object Type
  AS4_0 Ideal Loads Air, !- Zone Equipment 1 Name
  1,                             !- Zone Equipment 1 Cooling Sequence
  1;                             !- Zone Equipment 1 Heating or No-Load Sequence

NodeList,
  AS4_0 Inlets,     !- Name
  Node AS4_0 In;    !- Node 1 Name

ZoneHVAC:IdealLoadsAirSystem,
  AS4_0 Ideal Loads Air,  !- Name
  ,                        !- Availability Schedule Name
  Node AS4_0 In,   !- Zone Supply Air Node Name
  ,                        !- Zone Exhaust Air Node Name
  ,                        !- System Inlet Air Node Name
  35,                      !- Maximum Heating Supply Air Temperature {C}
  12,                      !- Minimum Cooling Supply Air Temperature {C}
  0.01,                    !- Maximum Heating Supply Air Humidity Ratio {kgWater/kgDryAir}
  0.008,                   !- Minimum Cooling Supply Air Humidity Ratio {kgWater/kgDryAir}
  LimitFlowRateAndCapacity,                 !- Heating Limit
  Autosize, !- MaximumHeatingAirFlowRate [m3/s]
  Autosize, !- MaximumSensibleHeatingCapacity [W]
  LimitFlowRateAndCapacity,                 !- Cooling Limit
  Autosize , !- MaximumCoolingAirFlowRate [m3/s]
  Autosize, !- MaximumTotalCoolingCapacity [W]
  Off, !- HeatingAvailabilitySchedule
  CoolAvail_AS4_0, !- CoolingAvailabilitySchedule
  Humidistat,                    !- Dehumidification Control Type
  ,                        !- Cooling Sensible Heat Ratio {dimensionless}
  Humidistat,                    !- Humidification Control Type
  AS4_0MinFreshAir,                        !- Design Specification Outdoor Air Object Name
  AS4_0OutdoorInlet,                        !- Outdoor Air Inlet Node Name
  OccupancySchedule,                        !- Demand Controlled Ventilation Type
  NoEconomizer,                        !- Outdoor Air Economizer Type
  None,                        !- Heat Recovery Type
  0.7, !-  SensibleHeatRecoveryEffectiveness
  0.65; !-  LatentHeatRecoveryEffectiveness




Sizing:Zone,
  AS4_0,                   !- Zone or ZoneList Name
  SupplyAirTemperature,    !- Zone Cooling Design Supply Air Temperature Input Method
  12,                      !- Zone Cooling Design Supply Air Temperature {C}
  ,                        !- Zone Cooling Design Supply Air Temperature Difference {deltaC}
  SupplyAirTemperature,    !- Zone Heating Design Supply Air Temperature Input Method
  35,                 !- Zone Heating Design Supply Air Temperature {C}
  ,                        !- Zone Heating Design Supply Air Temperature Difference {deltaC}
  0.009,                   !- Zone Cooling Design Supply Air Humidity Ratio {kgWater/kgDryAir}
  0.004,                   !- Zone Heating Design Supply Air Humidity Ratio {kgWater/kgDryAir}
  AS4_0MinFreshAir,        !- Design Specification Outdoor Air Object Name
  1.15,                   !- Zone Heating Sizing Factor
  1.15,                   !- Zone Cooling Sizing Factor
  DesignDay,               !- Cooling Design Air Flow Method
  ,                        !- Cooling Design Air Flow Rate {m3/s}
  ,                        !- Cooling Minimum Air Flow per Zone Floor Area {m3/s-m2}
  ,                        !- Cooling Minimum Air Flow {m3/s}
  ,                        !- Cooling Minimum Air Flow Fraction
  DesignDay,               !- Heating Design Air Flow Method
  ,                        !- Heating Design Air Flow Rate {m3/s}
  ,                        !- Heating Maximum Air Flow per Zone Floor Area {m3/s-m2}
  ,                        !- Heating Maximum Air Flow {m3/s}
  ,                        !- Heating Maximum Air Flow Fraction
  ,                        !- Design Specification Zone Air Distribution Object Name
  ,                        !- Account for Dedicated Outdoor Air System
  ,                        !- Dedicated Outdoor Air System Control Strategy
  ,                        !- Dedicated Outdoor Air Low Setpoint Temperature for Design {C}
  ;                        !- Dedicated Outdoor Air High Setpoint Temperature for Design {C}


!------------------------ Thermostat AS4_0------------------------

Schedule:Constant,
  AS4_0Heating_SP_Sch, !- Name
  Temperature, !- Schedule Type Limits Name
  20; !- HeatingSetpoint

Schedule:Constant,
  AS4_0Cooling_SP_Sch, !- Name
  Temperature, !- Schedule Type Limits Name
  26; !- CoolingSetpoint


ZoneControl:Thermostat,
  AS4_0 Thermostat, !- Name
  AS4_0,            !- Zone or ZoneList Name
  AS4_0_ZoneControlTypeSched, !- Control Type Schedule Name
  ThermostatSetpoint:DualSetpoint,  !- Control 1 Object Type
  Dual Setpoint - Zone AS4_0;  !- Control 1 Name

Schedule:Constant,
  AS4_0_ZoneControlTypeSched, !- Name
  Any Number, !- Schedule Type Limits Name
  4; !- Hourly Value

ThermostatSetpoint:DualSetpoint,
  Dual Setpoint - Zone AS4_0,  !- Name
  AS4_0Heating_SP_Sch,  !- Heating Setpoint Temperature Schedule Name
  AS4_0Cooling_SP_Sch;  !- Cooling Setpoint Temperature Schedule Name


!------------------------ Humidistat AS4_0------------------------

ZoneControl:Humidistat,
    AS4_0Humidistat,                  !-Name
    AS4_0,                   !-Zone Name
    AS4_0HumidMin,                !-Humidifying Relative Humidity Setpoint Schedule Name
    AS4_0HumidMax; !-Dehumidifying Relative Humidity Setpoint Schedule Name

Schedule:Constant,
    AS4_0HumidMin,                !- Name
    Any Number,              !- Schedule Type Limits Name
    20; !- MinHumidity

Schedule:Constant,
    AS4_0HumidMax,                !- Name
    Any Number,              !- Schedule Type Limits Name
    80; !- MaxHumidity


!------------------------ OutdoorAir AS4_0------------------------

DesignSpecification:OutdoorAir,
  AS4_0MinFreshAir,                  !- Name
  Sum,                     !- Outdoor Air Method
  0.0035396250000000002, !- @AS4_0-MinFreshAirPerson@ [m3/s-person]
  0.0003048017825043325, !- @AS4_0-MinFreshAirArea@ [m3/s-m2]
    ,                        !- Outdoor Air Flow per Zone [m3/s]
    ,                        !- Outdoor Air Flow Air Changes per Hour [1/hr]
    AllOn; !- MechVentSchedule



